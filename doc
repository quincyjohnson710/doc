<script>
    (function() {
        // ---------- JOB DATA (hospital & online only) ----------
        const jobs = [
            {
                id: 1,
                title: "Registered Nurse – Emergency Dept",
                employer: "St. Mary's General Hospital",
                type: "hospital",
                location: "Chicago, IL",
                salary: "$48/hr",
                fee: 4.99,
                posted: "2 days ago",
                icon: "fas fa-hospital"
            },
            {
                id: 2,
                title: "Telehealth Triage Nurse (Remote)",
                employer: "VirtualCare Health",
                type: "online",
                location: "Remote · US",
                salary: "$38/hr",
                fee: 3.49,
                posted: "5 hours ago",
                icon: "fas fa-wifi"
            },
            {
                id: 3,
                title: "Medical Lab Technician",
                employer: "Cleveland Clinic",
                type: "hospital",
                location: "Cleveland, OH",
                salary: "$32/hr",
                fee: 2.99,
                posted: "1 day ago",
                icon: "fas fa-hospital"
            },
            {
                id: 4,
                title: "Remote Medical Coder",
                employer: "HealthCode Solutions",
                type: "online",
                location: "Remote · US",
                salary: "$28/hr",
                fee: 4.49,
                posted: "3 days ago",
                icon: "fas fa-wifi"
            },
            {
                id: 5,
                title: "Patient Care Coordinator",
                employer: "Mayo Clinic",
                type: "hospital",
                location: "Rochester, MN",
                salary: "$26/hr",
                fee: 3.99,
                posted: "6 hours ago",
                icon: "fas fa-hospital"
            },
            {
                id: 6,
                title: "Telemedicine Psychiatrist (Remote)",
                employer: "Mindful Health Online",
                type: "online",
                location: "Remote · US",
                salary: "$120/hr",
                fee: 9.99,
                posted: "1 week ago",
                icon: "fas fa-wifi"
            },
            {
                id: 7,
                title: "Hospital Pharmacist",
                employer: "Johns Hopkins Hospital",
                type: "hospital",
                location: "Baltimore, MD",
                salary: "$55/hr",
                fee: 5.99,
                posted: "12 hours ago",
                icon: "fas fa-hospital"
            },
            {
                id: 8,
                title: "Remote Health Coach",
                employer: "Wellness Online Inc.",
                type: "online",
                location: "Remote · global",
                salary: "$22/hr",
                fee: 2.49,
                posted: "4 days ago",
                icon: "fas fa-wifi"
            }
        ];

        // ---------- STATE ----------
        let currentFilter = 'all';
        let currentSort = 'default';
        let selectedJobForPayment = null; // will hold the job object
        let activePaymentMethod = 'card'; // default

        // ---------- DOM refs ----------
        const jobGrid = document.getElementById('jobGrid');
        const jobCountSpan = document.getElementById('jobCount');
        const filterBtns = document.querySelectorAll('.filter-btn');
        const sortSelect = document.getElementById('sortSelect');
        const modalOverlay = document.getElementById('paymentModal');
        const modalJobInfo = document.getElementById('modalJobInfo');
        const cancelBtn = document.getElementById('cancelPayment');
        const confirmBtn = document.getElementById('confirmPayment');
        const paymentOptions = document.querySelectorAll('.payment-option');
        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toastMessage');

        // ---------- RENDER JOBS ----------
        function renderJobs() {
            // filter by type
            let filteredJobs = [...jobs];
            if (currentFilter === 'hospital') {
                filteredJobs = filteredJobs.filter(j => j.type === 'hospital');
            } else if (currentFilter === 'online') {
                filteredJobs = filteredJobs.filter(j => j.type === 'online');
            }

            // sorting
            if (currentSort === 'feeLow') {
                filteredJobs.sort((a, b) => a.fee - b.fee);
            } else if (currentSort === 'feeHigh') {
                filteredJobs.sort((a, b) => b.fee - a.fee);
            }
            // 'default' keeps original order (or we could sort by id)

            // update count
            jobCountSpan.textContent = filteredJobs.length;

            // if empty (should not happen with our data, but safe)
            if (filteredJobs.length === 0) {
                jobGrid.innerHTML = `<div class="no-results"><i class="fas fa-search" style="font-size:2rem; margin-bottom:1rem; display:block; color:#9bb7d0;"></i>No jobs match this filter.</div>`;
                return;
            }

            // build cards
            let html = '';
            filteredJobs.forEach(job => {
                const typeLabel = job.type === 'hospital' ? 'Hospital' : 'Online / Remote';
                const typeIcon = job.type === 'hospital' ? 'fa-hospital' : 'fa-wifi';
                const badgeClass = job.type === 'online' ? 'remote' : '';

                html += `
                    <div class="job-card" data-job-id="${job.id}">
                        <div class="job-type-badge ${badgeClass}">
                            <i class="fas ${typeIcon}"></i> ${typeLabel}
                        </div>
                        <div class="job-title">${job.title}</div>
                        <div class="employer">
                            <i class="fas fa-building"></i> ${job.employer}
                        </div>
                        <div class="job-meta">
                            <span><i class="fas fa-map-marker-alt"></i> ${job.location}</span>
                            <span><i class="fas fa-clock"></i> ${job.posted}</span>
                            <span><i class="fas fa-dollar-sign"></i> ${job.salary}</span>
                        </div>
                        <div class="fee-tag">
                            <i class="fas fa-lock"></i> Application fee $${job.fee.toFixed(2)}
                        </div>
                        <button class="apply-btn" data-job-id="${job.id}" data-fee="${job.fee}" data-title="${job.title.replace(/"/g, '&quot;')}">
                            <span>Apply now</span> <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                `;
            });

            jobGrid.innerHTML = html;

            // attach event listeners to all apply buttons
            document.querySelectorAll('.apply-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const jobId = parseInt(this.dataset.jobId, 10);
                    const job = jobs.find(j => j.id === jobId);
                    if (job) {
                        openPaymentModal(job);
                    }
                });
            });
        }

        // ---------- PAYMENT MODAL LOGIC ----------
        function openPaymentModal(job) {
            selectedJobForPayment = job;
            // update modal text
            modalJobInfo.textContent = `${job.title} · ${job.employer} · $${job.fee.toFixed(2)} fee`;
            // update prices in radio labels (optional, but we show dynamic fee)
            document.querySelectorAll('.payment-option .price').forEach(el => {
                el.textContent = `$${job.fee.toFixed(2)}`;
            });

            // reset selected payment option (visual)
            paymentOptions.forEach(opt => opt.classList.remove('selected'));
            const defaultOption = document.querySelector('.payment-option[data-method="card"]');
            if (defaultOption) {
                defaultOption.classList.add('selected');
                const radio = defaultOption.querySelector('input[type="radio"]');
                if (radio) radio.checked = true;
                activePaymentMethod = 'card';
            }

            modalOverlay.classList.add('show');
        }

        function closePaymentModal() {
            modalOverlay.classList.remove('show');
            selectedJobForPayment = null;
        }

        // payment option visual selection
        paymentOptions.forEach(opt => {
            const radio = opt.querySelector('input[type="radio"]');
            // click on container selects radio
            opt.addEventListener('click', function(e) {
                // don't interfere if clicking directly on radio (it works anyway)
                if (e.target.tagName !== 'INPUT') {
                    radio.checked = true;
                }
                // remove selected class from all
                paymentOptions.forEach(o => o.classList.remove('selected'));
                this.classList.add('selected');
                activePaymentMethod = this.dataset.method;
            });
            // if radio gets changed via keyboard etc.
            radio.addEventListener('change', function() {
                if (this.checked) {
                    paymentOptions.forEach(o => o.classList.remove('selected'));
                    opt.classList.add('selected');
                    activePaymentMethod = opt.dataset.method;
                }
            });
        });

        // Confirm payment -> simulate successful payment, then show toast and close.
        function handleConfirmPayment() {
            if (!selectedJobForPayment) return;

            // disable button to prevent double submission (simulate processing)
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing…';

            // simulate network request
            setTimeout(() => {
                // success
                const jobTitle = selectedJobForPayment.title;
                closePaymentModal();

                // show toast
                toastMessage.textContent = `✅ Payment successful! Application sent for “${jobTitle}”.`;
                toast.classList.add('show');
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 3800);

                // restore confirm button state
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="fas fa-check-circle"></i> Pay & apply';

                // optionally reset selection
                selectedJobForPayment = null;
            }, 900);
        }

        // ---------- TOAST HANDLER (with adjustable message) ----------
        function showToast(message) {
            toastMessage.textContent = message;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3500);
        }

        // ---------- FILTER & SORT EVENT LISTENERS ----------
        filterBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                filterBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentFilter = this.dataset.filter;
                renderJobs();
            });
        });

        sortSelect.addEventListener('change', function() {
            currentSort = this.value;
            renderJobs();
        });

        // modal cancel
        cancelBtn.addEventListener('click', closePaymentModal);
        // click on overlay closes modal (but not on modal box itself)
        modalOverlay.addEventListener('click', function(e) {
            if (e.target === modalOverlay) {
                closePaymentModal();
            }
        });

        // confirm payment button
        confirmBtn.addEventListener('click', handleConfirmPayment);

        // close modal with ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modalOverlay.classList.contains('show')) {
                closePaymentModal();
            }
        });

        // initial render
        renderJobs();

        // Ensure that if any apply button is dynamically added after render (but it's only via renderJobs, so fine)
    })();
</script>

<!-- optional fallback for older browsers -->
<noscript>Your browser does not support JavaScript. Please enable it to see jobs.</noscript>
</body>
</html>
